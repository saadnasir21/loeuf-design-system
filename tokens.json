{
  "$brand": "loeuf",
  "$description": "Design tokens for loeuf.pk — contemporary Pakistani fashion. Anchor color Mist #EAEAEA.",
  "color": {
    "neutral": {
      "noir":     { "value": "#161616", "role": "primary ink / near-black" },
      "charcoal": { "value": "#2E2E2E", "role": "dark surfaces, headings" },
      "graphite": { "value": "#555555", "role": "secondary text" },
      "stone":    { "value": "#8A8A8A", "role": "muted text, placeholders" },
      "silver":   { "value": "#C4C4C4", "role": "strong borders, disabled" },
      "mist":     { "value": "#EAEAEA", "role": "SIGNATURE — page background, surfaces, dividers" },
      "cloud":    { "value": "#F1F0EE", "role": "subtle fill on white surfaces" },
      "blanc":    { "value": "#FAF9F6", "role": "warm off-white surface (alt)" },
      "white":    { "value": "#FFFFFF", "role": "pure white, cards" }
    },
    "accent": {
      "rose":      { "value": "#C97F75", "role": "SIGNATURE accent — badges, sale, tags" },
      "rose-deep": { "value": "#B0685E", "role": "rose hover / pressed" },
      "yolk":      { "value": "#DDA63A", "role": "secondary accent / statement" },
      "yolk-deep": { "value": "#B9842A", "role": "yolk hover, links" },
      "almond":    { "value": "#E7DECF", "role": "warm tinted surface" },
      "clay":      { "value": "#B5654B", "role": "rare editorial pop" }
    },
    "semantic": {
      "success": { "value": "#4F7A5B" },
      "error":   { "value": "#A93B2E" },
      "sale":    { "value": "#C97F75" }
    }
  },
  "typography": {
    "family": {
      "display": "Fraunces, 'Times New Roman', Georgia, serif",
      "sans": "Gotham, Montserrat, 'Helvetica Neue', Arial, sans-serif"
    },
    "size": {
      "eyebrow": "12px", "caption": "13px", "small": "14px",
      "body": "16px", "body-lg": "18px",
      "h4": "20px", "h3": "24px", "h2": "32px", "h1": "40px",
      "display": "56px", "display-xl": "72px"
    },
    "weight": { "light": 300, "regular": 400, "medium": 500, "semibold": 600 },
    "lineHeight": { "tight": 1.05, "snug": 1.2, "normal": 1.5, "relaxed": 1.7 },
    "letterSpacing": { "tight": "-0.02em", "normal": "0", "wide": "0.08em", "eyebrow": "0.18em" }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px",
    "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "128px"
  },
  "radius": { "none": "0", "sm": "2px", "md": "4px", "lg": "8px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(22,22,22,0.05)",
    "md": "0 6px 20px rgba(22,22,22,0.08)",
    "lg": "0 18px 48px rgba(22,22,22,0.12)"
  },
  "motion": {
    "duration": { "fast": "120ms", "base": "220ms", "slow": "420ms" },
    "ease": { "standard": "cubic-bezier(0.4,0,0.2,1)", "emphasis": "cubic-bezier(0.2,0.8,0.2,1)" }
  },
  "layout": { "containerMax": "1200px", "containerText": "680px" }
}
